# Server-only operator credential. Never use a VITE_ prefix.
VALIRON_API_KEY=
# The dedicated /api/trust/protected route requires this score and a prod route.
TRUST_GATE_MIN_SCORE=70

# Hosted backend (Render sets NODE_ENV and RENDER_EXTERNAL_URL via Blueprint).
# PUBLIC_URL=https://your-backend.onrender.com
# ALLOWED_ORIGINS=https://your-project.vercel.app

# Vercel only: public backend origin, no path or trailing slash.
# Leave unset for a single-service Render deployment or local development.
# VITE_API_BASE_URL=https://your-backend.onrender.com

# Research stays private and disabled on hosted deployments by default.
# ENABLE_RESEARCH=false
# RESEARCH_TERMS_ACKNOWLEDGED=false
# RESEARCH_FILE=/etc/secrets/village.json
# HF_TOKEN is needed only for the offline importer, never by the web app.
